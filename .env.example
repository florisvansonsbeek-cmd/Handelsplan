# Overzicht van de variabelen. Zet de waarden in Railway -> je dienst -> Variables, NOOIT in GitHub.
# Commentaar staat op aparte regels, zodat je de regels zo in de Raw Editor kunt plakken.

# --- Verplicht ---
# Het wachtwoord om in te loggen, of een pincode van 4 tot 8 cijfers (dan krijg je een pincodeveld; max. 10 foute pogingen per dag):
APP_PASSWORD=
# Komt vanzelf van de PostgreSQL-dienst in Railway (Add Variable Reference):
DATABASE_URL=

# --- Grok (xAI) ---
XAI_API_KEY=
# Optioneel ander model (bestaat het niet in je account, dan kiest de site zelf het nieuwste Grok-model):
# XAI_MODEL=grok-4.7

# --- E-mail via iCloud IMAP (app-specifiek wachtwoord van account.apple.com) ---
EMAIL_HOST=imap.mail.me.com
EMAIL_PORT=993
# De naam vóór @icloud.com, ook als je mail op een eigen domein ontvangt (iCloud+):
EMAIL_USER=
EMAIL_PASS=
# Alleen mail aan dit adres ophalen en analyseren (meerdere met komma's):
# EMAIL_TO=naam@jouwdomein.nl
# Optioneel: eigen map, hoe ver terug bij de eerste keer, hoe vaak ophalen (minuten):
# EMAIL_FOLDER=Handelsplan
# EMAIL_SINCE_DAYS=14
# EMAIL_INTERVAL_MIN=15

# --- Optioneel ---
# Live koersen van aandelen en ETF's (zonder sleutel komen ze van Yahoo Finance):
FINNHUB_API_KEY=
# Push naar je telefoon met de app ntfy (meldingen bij planregels en rode signalen):
# NTFY_TOPIC=
# Niet nodig: marktcijfers komen zonder sleutel van FRED (csv), Yahoo Finance en CoinGecko.
# FRED_API_KEY=
# TWELVEDATA_API_KEY=
# Transcripts vanaf je laptop:
# INBOX_TOKEN=
# Link in meldingen:
# SITE_URL=https://plan.vsonsbeek.nl
